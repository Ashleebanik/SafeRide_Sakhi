# =============================================================
# SafeRide Sakhi – Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# =============================================================

# ---- IBM watsonx (Granite 4) ----
WATSONX_API_KEY=your_ibm_watsonx_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ---- Google Maps JS API ----
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ---- Google Gemini ----
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Groq ----
GROQ_API_KEY=your_groq_api_key_here

# ---- Emergency Services ----
EMERGENCY_NUMBER=112
CONTROL_ROOM_WEBHOOK=https://your-control-room.example.com/alert

# ---- App Settings ----
APP_ENV=development          # development | production
LOG_LEVEL=INFO
TRIP_DATA_RETENTION_DAYS=7

# ---- ChromaDB (vector store) ----
CHROMA_PERSIST_DIR=./data/chroma_store
